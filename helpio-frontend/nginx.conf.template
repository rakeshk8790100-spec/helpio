# Served by the frontend image. ${PORT}, ${API_SCHEME}, ${API_HOST} and ${NGINX_LOCAL_RESOLVERS} are filled in
# when the container starts (Render sets PORT; docker compose leaves the default 80).

# Look the API host up per request (re-checked every 30s), so nginx starts even before the API is up
resolver ${NGINX_LOCAL_RESOLVERS} valid=30s ipv6=off;

server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;

    # Job photos/videos are up to 10 MB each
    client_max_body_size 60m;

    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # API: same origin for the browser, so no CORS setup is needed
    location /api/ {
        # A variable makes nginx resolve per request; with no URI part, the original path is passed on
        set $api_upstream ${API_SCHEME}://${API_HOST};
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        # The API's own host name (needed when it's reached over its public https URL)
        proxy_set_header Host $proxy_host;
        proxy_ssl_server_name on;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }

    location = /healthz {
        access_log off;
        return 200 "ok\n";
    }

    # Hashed build files never change: cache for a year
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # Single-page app: unknown paths load index.html, which must never be cached
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
    }
}
