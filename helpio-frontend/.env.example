# Copy to .env.local (git-ignored) and fill in.

# Google Identity Services "Web client ID" (public; it ships in the browser bundle).
# Use the same ID as the backend's GOOGLE_CLIENT_ID, and list every app origin (e.g. http://localhost:5173)
# under the OAuth client's "Authorised JavaScript origins".
# Leave empty to hide "Continue with Google" (development builds show a reminder in its place).
VITE_GOOGLE_CLIENT_ID=

# API base path. Defaults to /api/v1, which the dev server proxies to the backend.
# In production, point it at the API origin, e.g. https://api.helpio.in/api/v1
VITE_API_BASE_URL=

# Dev server only: where /api is proxied. Defaults to http://127.0.0.1:8000
VITE_API_PROXY_TARGET=

# Which client's screens to build: src/clients/<name> (default: "default")
VITE_ORG_NAME=
