# Copy to .env.dev (and .env.prod for production). Never commit real values.
APP_ENV=dev

# Supabase > Connect > Session pooler
DB_HOST=
DB_PORT=5432
DB_NAME=postgres
DB_USER=
DB_PASSWORD=
DB_SSLMODE=require
DB_SSLROOTCERT=

# Long random string (e.g. python -c "import secrets; print(secrets.token_urlsafe(48))")
AUTH_SECRET_KEY=
# Session length in minutes (default 30 days)
AUTH_TOKEN_MINUTES=43200
# Dev only: print login codes to the console instead of emailing them
AUTH_DEV_EMAIL_CONSOLE=false

BREVO_SMTP_LOGIN=
BREVO_SMTP_KEY=
BREVO_FROM_EMAIL=

# Cloudinary console > Dashboard (job photos and videos). The secret is server-only.
CLOUDINARY_CLOUD_NAME=
# Unsigned upload preset (Settings > Upload > Upload presets). Without it, the key and secret sign each upload.
CLOUDINARY_UPLOAD_PRESET=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google Cloud > Credentials > OAuth 2.0 Web client ID
GOOGLE_CLIENT_ID=

# Browser origins allowed to call the API directly, comma-separated (not needed with the Vite dev proxy)
CORS_ORIGINS=

# Razorpay > Account & Settings > API Keys. The secret is server-only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# The secret typed when adding the webhook (Razorpay > Webhooks)
RAZORPAY_WEBHOOK_SECRET=
# Minutes a payment link stays open (default 1 day, at least 16)
PAYMENT_LINK_EXPIRY_MINUTES=1440

# The owner of the admin console: approves other admins and manages API keys and settings
ADMIN_OWNER_EMAIL=
# Admin console sessions, in minutes (default 12 hours); every log-in also needs an emailed code
AUTH_ADMIN_TOKEN_MINUTES=720

# New customers can't log in, and new providers can't quote or be found, until an admin approves them
REQUIRE_CUSTOMER_APPROVAL=false
REQUIRE_PROVIDER_APPROVAL=false
# Email the owner when a sign-up is waiting for approval
NOTIFY_NEW_SIGNUPS=true

# Encrypts API keys saved in the admin console (a Fernet key). Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Never change it once keys are saved (they become unreadable). Without it, secrets come from .env only.
SETTINGS_ENCRYPTION_KEY=
