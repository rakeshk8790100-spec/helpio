# Copy to .env (git-ignored) for docker compose. Backend secrets stay in helpio-backend/.env.dev / .env.prod.

# dev or prod: which helpio-backend/.env.<APP_ENV> the API container reads
APP_ENV=dev

# Port the web app is published on: http://localhost:8080
WEB_PORT=8080

# Google sign-in "Web client ID" (public; baked into the web bundle at build time). Same as the backend's
# GOOGLE_CLIENT_ID. Add the site's origin (e.g. http://localhost:8080) to the OAuth client's JavaScript origins.
VITE_GOOGLE_CLIENT_ID=

# Which client's screens to build: helpio-frontend/src/clients/<name>
VITE_ORG_NAME=default
